{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesaresearchhub.it/schemas/workload-contract-v1.schema.json",
  "title": "SRH Workload Contract",
  "description": "Portable description of an AI application workload and its service objectives.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "workload_class",
    "traffic",
    "request_profile",
    "service_objectives",
    "response_contract"
  ],
  "properties": {
    "schema": {
      "const": "srh.workload-contract.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "workload_class": {
      "type": "string",
      "enum": [
        "chat",
        "rag",
        "reasoning",
        "document-analysis",
        "agent",
        "extraction",
        "classification",
        "mixed"
      ]
    },
    "traffic": {
      "type": "object",
      "required": [
        "concurrent_users"
      ],
      "properties": {
        "concurrent_users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "requests_per_minute": {
          "type": "number",
          "minimum": 0
        },
        "burst_factor": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "request_profile": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/tokenDistribution"
        },
        "output_tokens": {
          "$ref": "#/$defs/tokenDistribution"
        },
        "reasoning": {
          "type": "string",
          "enum": [
            "disabled",
            "optional",
            "required"
          ],
          "default": "disabled"
        },
        "streaming": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "context_behavior": {
      "type": "object",
      "properties": {
        "shared_prefix_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repeated_context_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_required_context_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "calls_per_request": {
          "$ref": "#/$defs/numericDistribution"
        }
      },
      "additionalProperties": false
    },
    "service_objectives": {
      "type": "object",
      "properties": {
        "ttft_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ttfa_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "answer_tokens_per_second_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "end_to_end_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "error_rate_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "grounding_required": {
          "type": "boolean"
        },
        "citation_required": {
          "type": "boolean"
        },
        "tool_call_correctness_required": {
          "type": "boolean"
        },
        "structured_output_required": {
          "type": "boolean"
        },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "response_contract": {
      "type": "object",
      "required": [
        "modes",
        "default_mode",
        "structured_result_required",
        "probe_max_tokens",
        "assistant_max_tokens"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "probe",
              "assistant"
            ]
          }
        },
        "default_mode": {
          "type": "string",
          "enum": [
            "probe",
            "assistant"
          ]
        },
        "structured_result_required": {
          "type": "boolean"
        },
        "probe_max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "assistant_max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "tokenDistribution": {
      "type": "object",
      "required": [
        "p50",
        "p95"
      ],
      "properties": {
        "p50": {
          "type": "integer",
          "minimum": 1
        },
        "p95": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "numericDistribution": {
      "type": "object",
      "properties": {
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
