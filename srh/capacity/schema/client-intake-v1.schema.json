{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesaresearchhub.it/schemas/client-intake-v1.schema.json",
  "title": "SRH Client Intake",
  "description": "Business-readable inputs captured during a private AI discovery session.",
  "type": "object",
  "required": ["schema", "id", "traffic", "documents", "responses", "experience", "exploration"],
  "properties": {
    "schema": {"const": "srh.client-intake.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "workload_class": {"enum": ["chat", "rag", "reasoning", "document-analysis", "agent", "extraction", "classification", "mixed"]},
    "reasoning": {"enum": ["disabled", "optional", "required"]},
    "traffic": {
      "type": "object",
      "required": ["total_users", "concurrent_users", "requests_per_day", "peak_requests_per_minute"],
      "properties": {
        "total_users": {"type": "integer", "minimum": 1},
        "concurrent_users": {"type": "integer", "minimum": 1},
        "requests_per_day": {"type": "number", "exclusiveMinimum": 0},
        "peak_requests_per_minute": {"type": "number", "exclusiveMinimum": 0},
        "burst_factor": {"type": "number", "minimum": 1}
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "required": ["pages", "retrieved_pages"],
      "properties": {
        "context_mode": {"enum": ["retrieval", "full-document"]},
        "pages": {"$ref": "#/$defs/distribution"},
        "retrieved_pages": {"$ref": "#/$defs/distribution"},
        "scanned_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "shared_prefix_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "repeated_context_probability": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "object",
      "required": ["words"],
      "properties": {"words": {"$ref": "#/$defs/distribution"}},
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "required": ["first_useful_response_seconds", "complete_response_seconds"],
      "properties": {
        "first_useful_response_seconds": {"type": "number", "exclusiveMinimum": 0},
        "complete_response_seconds": {"type": "number", "exclusiveMinimum": 0},
        "error_rate_max": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "grounding_required": {"type": "boolean"},
        "citation_required": {"type": "boolean"},
        "structured_output_required": {"type": "boolean"},
        "minimum_score": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "data_residency": {"enum": ["on-premises", "srh-lab", "private-cloud"]},
        "maximum_device_power_w": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "exploration": {
      "type": "object",
      "required": ["hardware_ids", "model_ids", "weight_bits"],
      "properties": {
        "hardware_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "model_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "requested_model_families": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "weight_bits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      },
      "additionalProperties": false
    },
    "translation_assumptions": {
      "type": "object",
      "properties": {
        "words_per_page": {"type": "number", "exclusiveMinimum": 0},
        "tokens_per_word": {"type": "number", "exclusiveMinimum": 0},
        "prompt_overhead_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "distribution": {
      "type": "object",
      "required": ["p50", "p95", "max"],
      "properties": {
        "p50": {"type": "number", "exclusiveMinimum": 0},
        "p95": {"type": "number", "exclusiveMinimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  }
}
